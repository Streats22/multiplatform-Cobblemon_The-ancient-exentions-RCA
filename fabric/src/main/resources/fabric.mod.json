{
  "schemaVersion": 1,
  "id": "ancient_extensions",
  "version": "${mod_version}",
  "name": "The Ancient Extensions",
  "description": "Rubius Cobblemon glue mod — Regional Survey, kit, passport, journal, and migration. Requires Cobblemon 1.7.x on Minecraft 1.21.1.",
  "authors": ["Streats1"],
  "license": "MIT",
  "icon": "assets/ancient_extensions/icon.png",
  "contact": {
    "homepage": "https://modrinth.com/modpack/rubius-cobblemon"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["nl.streats1.ancientextensions.fabric.AncientExtensionsFabric"],
    "client": ["nl.streats1.ancientextensions.fabric.client.AncientExtensionsFabricClient"]
  },
  "depends": {
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin}",
    "cobblemon": ">=1.7.3 <1.8.0"
  },
  "recommends": {
    "regions_unexplored": ">=${regions_unexplored_version}",
    "comforts": "*",
    "lootr": "*",
    "jei": "*"
  },
  "breaks": {
    "cobblemon": "<1.7.3 || >=1.8.0"
  }
}
